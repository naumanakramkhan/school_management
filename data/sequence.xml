<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Student ID -->
        <record id="seq_school_student" model="ir.sequence">
            <field name="name">Student ID Sequence</field>
            <field name="code">school.student</field>
            <field name="prefix">STU</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Teacher ID -->
        <record id="seq_school_teacher" model="ir.sequence">
            <field name="name">Teacher ID Sequence</field>
            <field name="code">school.teacher</field>
            <field name="prefix">TCH</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Course Code -->
        <record id="seq_school_course" model="ir.sequence">
            <field name="name">Course Code Sequence</field>
            <field name="code">school.course</field>
            <field name="prefix">CRS</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Grade Reference -->
        <record id="seq_school_grade" model="ir.sequence">
            <field name="name">Grade Reference Sequence</field>
            <field name="code">school.grade.sequence</field>
            <field name="prefix">GRD</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Student Fee -->
        <record id="seq_student_fee" model="ir.sequence">
            <field name="name">Student Fee Sequence</field>
            <field name="code">student.fee</field>
            <field name="prefix">FEE/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
