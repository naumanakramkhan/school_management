<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Course Tree View -->
    <record id="view_course_tree" model="ir.ui.view">
        <field name="name">school.course.tree</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <tree string="Courses">
                <field name="course_code"/>
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
                <field name="credits"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <!-- Course Form View -->
    <record id="view_course_form" model="ir.ui.view">
        <field name="name">school.course.form</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="Enter course name..."/>
                            <field name="course_code" readonly="1"/>
                            <field name="teacher_id" options="{'no_create': True}"/>
                            <field name="credits"/>
                        </group>
                        <group>
                            <field name="duration_hours"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="student_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter course description, objectives, and syllabus..."/>
                        </page>
                        <page string="Classes">
                            <field name="class_ids" options="{'no_create': True}">
                                <tree>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="academic_year"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Enrolled Students">
                            <field name="student_ids" options="{'no_create': True}">
                                <tree>
                                    <field name="student_code"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Course Kanban View -->
    <record id="view_course_kanban" model="ir.ui.view">
        <field name="name">school.course.kanban</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
                <field name="course_code"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="course_code"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span>Teacher: <field name="teacher_id"/></span><br/>
                                        <span>Students: <field name="student_count"/></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Course Action -->
    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.course</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first course
            </p>
            <p>
                Click the create button to add a new course to your school.
            </p>
        </field>
    </record>

    <!-- Menu Item for Courses -->
    <menuitem id="menu_school_courses"
              name="Courses"
              parent="menu_school_root"
              action="action_course"
              sequence="40"/>
</odoo>
