<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_student_fee_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 13px;">

                        <!-- Header Banner -->
                        <div class="row mt-3 mb-4">
                            <div class="col-8">
                                <h2 style="color: #1f3c88; font-weight: bold; margin-bottom: 2px;">
                                    FEE PAYMENT RECEIPT
                                </h2>
                                <span class="badge bg-success" style="font-size: 12px; padding: 5px 10px;">
                                    OFFICIAL ACKNOWLEDGMENT
                                </span>
                            </div>
                            <div class="col-4 text-end" style="border-left: 3px solid #1f3c88; padding-left: 12px;">
                                <strong>Receipt No:</strong> <span t-field="doc.name"/><br/>
                                <strong>Date:</strong> <span t-field="doc.date" t-options='{"widget": "date"}'/><br/>
                                <strong style="text-transform: capitalize;">Status:</strong> <span t-field="doc.state"/><br/>
                            </div>
                        </div>

                        <!-- Student Information Card -->
                        <div class="card mb-4" style="border: 1px solid #dee2e6; border-radius: 6px;">
                            <div class="card-header" style="background-color: #1f3c88; color: white; font-weight: bold; padding: 8px 15px;">
                                STUDENT DETAILS
                            </div>
                            <div class="card-body" style="padding: 12px 15px;">
                                <div class="row">
                                    <div class="col-6">
                                        <p class="mb-1"><strong>Student Name:</strong> <span t-field="doc.student_id.name"/></p>
                                        <p class="mb-0" t-if="doc.student_id.email"><strong>Email:</strong> <span t-field="doc.student_id.email"/></p>
                                    </div>
                                    <div class="col-6">
                                        <p class="mb-1" t-if="doc.student_id.phone"><strong>Contact No:</strong> <span t-field="doc.student_id.phone"/></p>
                                        <p class="mb-0" t-if="doc.due_date"><strong>Due Date:</strong> <span t-field="doc.due_date" t-options='{"widget": "date"}'/></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Particulars Table -->
                        <table class="table table-bordered table-sm mb-4" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background-color: #f8f9fa; color: #333; text-align: left;">
                                    <th style="width: 8%;">#</th>
                                    <th style="width: 62%;">Fee Type / Description</th>
                                    <th style="width: 30%; text-align: right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1</td>
                                    <td><span t-field="doc.fee_type_id.name"/></td>
                                    <td class="text-end">
                                        <span t-field="doc.amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Calculation & Summary Box -->
                        <div class="row mb-5">
                            <div class="col-7">
                                <div style="border: 1px dashed #6c757d; padding: 10px; border-radius: 4px; background-color: #fafafa;">
                                    <p class="mb-1" t-if="doc.move_id"><strong>Linked Invoice:</strong> <span t-field="doc.move_id.name"/></p>
                                    <p class="mb-0" t-if="doc.note"><strong>Notes:</strong> <span t-field="doc.note"/></p>
                                </div>
                            </div>
                            <div class="col-5">
                                <table class="table table-sm table-borderless">
                                    <tr style="border-top: 2px solid #333;">
                                        <td><strong>Total Amount:</strong></td>
                                        <td class="text-end" style="color: #1f3c88; font-weight: bold;">
                                            <span t-field="doc.amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Signatures & Verification Stamp -->
                        <div class="row pt-4" style="margin-top: 40px;">
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #333; width: 70%; margin: 0 auto; padding-top: 5px;">
                                    <strong>Student / Parent Signature</strong>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #333; width: 70%; margin: 0 auto; padding-top: 5px;">
                                    <strong>Authorized Accounts Officer</strong><br/>
                                    <span style="font-size: 10px; color: #6c757d;">Future Scholars Academy</span>
                                </div>
                            </div>
                        </div>

                        <!-- Footer Notice -->
                        <div class="text-center mt-5 pt-3" style="font-size: 11px; color: #6c757d; border-top: 1px solid #dee2e6;">
                            * This is a computer-generated receipt. Fees once deposited are non-refundable. *
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>