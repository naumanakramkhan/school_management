<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Classes ================= -->
    <record id="view_school_class_tree" model="ir.ui.view">
        <field name="name">school.class.tree</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <tree string="Classes">
                <field name="code"/>
                <field name="name"/>
                <field name="academic_year"/>
                <field name="class_teacher_id"/>
                <field name="student_count"/>
            </tree>
        </field>
    </record>

    <record id="view_school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <header>
                    <button name="action_take_attendance" string="Take Attendance" type="object"
                            class="oe_highlight" invisible="student_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Grade 5 - A"/>
                            <field name="code"/>
                            <field name="academic_year"/>
                        </group>
                        <group>
                            <field name="class_teacher_id" options="{'no_create': True}"/>
                            <field name="student_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students" name="students">
                            <field name="student_ids" options="{'no_create': True}">
                                <tree>
                                    <field name="student_code"/>
                                    <field name="name"/>
                                    <field name="student_gender"/>
                                    <field name="phone"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Teachers" name="teachers">
                            <field name="teacher_ids" options="{'no_create': True}">
                                <tree>
                                    <field name="teacher_code"/>
                                    <field name="name"/>
                                    <field name="teacher_subject"/>
                                    <field name="phone"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Courses" name="courses">
                            <field name="course_ids" options="{'no_create': True}">
                                <tree>
                                    <field name="course_code"/>
                                    <field name="name"/>
                                    <field name="teacher_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_school_class_search" model="ir.ui.view">
        <field name="name">school.class.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <search string="Search Classes">
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year"/>
                <field name="class_teacher_id"/>
            </search>
        </field>
    </record>

    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first class</p>
            <p>A class groups students, teachers and courses, e.g. "Grade 5 - A".</p>
        </field>
    </record>

    <menuitem id="menu_school_classes" name="Classes" parent="menu_school_root"
              action="action_school_class" sequence="35"/>

    <!-- ===== Classes and Courses tabs on the Contact form (students and teachers) ===== -->
    <record id="view_partner_form_school_tabs" model="ir.ui.view">
        <field name="name">res.partner.form.school.tabs</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Classes" name="school_classes" invisible="not is_student and not is_teacher">
                    <field name="student_class_ids" invisible="not is_student"
                           options="{'no_create': True}">
                        <tree>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="academic_year"/>
                            <field name="class_teacher_id"/>
                        </tree>
                    </field>
                    <field name="teacher_class_ids" invisible="not is_teacher or is_student"
                           options="{'no_create': True}">
                        <tree>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="academic_year"/>
                            <field name="class_teacher_id"/>
                        </tree>
                    </field>
                </page>
                <page string="Courses" name="school_courses" invisible="not is_student and not is_teacher">
                    <field name="student_course_ids" invisible="not is_student"
                           options="{'no_create': True}">
                        <tree>
                            <field name="course_code"/>
                            <field name="name"/>
                            <field name="teacher_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </tree>
                    </field>
                    <field name="teacher_course_ids" invisible="not is_teacher or is_student"
                           options="{'no_create': True}">
                        <tree>
                            <field name="course_code"/>
                            <field name="name"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
