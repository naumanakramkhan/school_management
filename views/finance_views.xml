<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Fee Types ================= -->
    <record id="view_student_fee_type_tree" model="ir.ui.view">
        <field name="name">student.fee.type.tree</field>
        <field name="model">student.fee.type</field>
        <field name="arch" type="xml">
            <tree string="Fee Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="product_id"/>
                <field name="account_id"/>
                <field name="default_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_student_fee_type_form" model="ir.ui.view">
        <field name="name">student.fee.type.form</field>
        <field name="model">student.fee.type</field>
        <field name="arch" type="xml">
            <form string="Fee Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="default_amount"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="account_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_fee_type" model="ir.actions.act_window">
        <field name="name">Fee Types</field>
        <field name="res_model">student.fee.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================= Student Fees ================= -->
    <record id="view_student_fee_form" model="ir.ui.view">
        <field name="name">student.fee.form</field>
        <field name="model">student.fee</field>
        <field name="arch" type="xml">
            <form string="Student Fee">
                <header>
                    <button name="action_create_invoice" string="Create Invoice" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'invoiced'"
                            confirm="Cancel this fee and its invoice?"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="fee_type_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="amount" widget="monetary" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state != 'draft'"/>
                            <field name="move_id" string="Linked Invoice"/>
                            <field name="payment_state" invisible="not move_id" widget="badge"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Internal notes..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_student_fee_tree" model="ir.ui.view">
        <field name="name">student.fee.tree</field>
        <field name="model">student.fee</field>
        <field name="arch" type="xml">
            <tree string="Student Fees">
                <field name="name"/>
                <field name="student_id"/>
                <field name="fee_type_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
                <field name="payment_state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_student_fee_search" model="ir.ui.view">
        <field name="name">student.fee.search</field>
        <field name="model">student.fee</field>
        <field name="arch" type="xml">
            <search string="Search Fees">
                <field name="name"/>
                <field name="student_id"/>
                <field name="fee_type_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Invoiced" name="invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter string="Unpaid" name="unpaid"
                        domain="[('state', '=', 'invoiced'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter string="Paid" name="paid"
                        domain="[('payment_state', 'in', ('paid', 'in_payment'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Fee Type" name="group_fee_type" context="{'group_by': 'fee_type_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Payment Status" name="group_payment" context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_student_fee" model="ir.actions.act_window">
        <field name="name">Student Fees</field>
        <field name="res_model">student.fee</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================= Menus ================= -->
    <menuitem id="menu_school_finance_root" name="Finance" parent="menu_school_root"
              sequence="20" groups="account.group_account_invoice"/>
    <menuitem id="menu_student_fee" name="Student Fees" parent="menu_school_finance_root"
              action="action_student_fee" sequence="10"/>
    <menuitem id="menu_student_fee_type" name="Fee Types" parent="menu_school_finance_root"
              action="action_student_fee_type" sequence="20" groups="account.group_account_manager"/>
</odoo>
