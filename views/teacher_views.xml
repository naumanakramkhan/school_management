<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add teacher fields to standard Contact form -->
    <record id="view_partner_form_teacher" model="ir.ui.view">
        <field name="name">res.partner.form.teacher</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Teacher Info" name="teacher_info">
                    <group>
                        <group string="Basic Details">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="is_teacher"/>
                            <field name="teacher_code" invisible="not is_teacher"/>
                            <field name="teacher_subject" invisible="not is_teacher"/>
                            <field name="teacher_qualification" invisible="not is_teacher"/>
                        </group>
                        <group string="Employment Details" invisible="not is_teacher">
                            <field name="teacher_joining_date"/>
                            <field name="teacher_experience_years"/>
                        </group>
                    </group>
                    <group string="Teaching Assignments" invisible="not is_teacher">
                        <field name="teacher_class_ids" widget="many2many_tags"/>
                        <field name="teacher_course_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Teacher Search Filter -->
    <record id="view_partner_search_teacher" model="ir.ui.view">
        <field name="name">res.partner.search.teacher</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="teacher_code"/>
                <field name="teacher_subject"/>
                <field name="teacher_class_ids"/>
                <field name="teacher_course_ids"/>
                <filter string="Teachers" name="teachers" domain="[('is_teacher', '=', True)]"/>
                <separator/>
                <filter string="Archived / Left Teachers" name="inactive" domain="[('active', '=', False), ('is_teacher', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Teacher Tree (List) View -->
    <record id="view_partner_teacher_tree" model="ir.ui.view">
        <field name="name">res.partner.teacher.tree</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <tree string="Teachers">
                <field name="teacher_code"/>
                <field name="name"/>
                <field name="teacher_subject"/>
                <field name="teacher_class_ids" widget="many2many_tags"/>
                <field name="teacher_course_ids" widget="many2many_tags"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="teacher_experience_years"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Teacher Kanban View -->
    <record id="view_partner_teacher_kanban" model="ir.ui.view">
        <field name="name">res.partner.teacher.kanban</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="teacher_code"/>
                <field name="teacher_subject"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="teacher_class_ids"/>
                <field name="avatar_128"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image: url('#{kanban_image('res.partner', 'avatar_128', record.id.raw_value)}')"/>
                            <div class="oe_kanban_details d-flex flex-column justify-content-between ms-2">
                                <div>
                                    <strong class="o_kanban_record_title oe_partner_heading">
                                        <field name="name"/>
                                    </strong>
                                    <div t-if="record.teacher_code.raw_value" class="text-muted small">
                                        <i class="fa fa-id-card me-1"/> <field name="teacher_code"/>
                                    </div>
                                    <div t-if="record.teacher_subject.raw_value" class="mt-1">
                                        <span class="badge text-bg-primary me-1"><field name="teacher_subject"/></span>
                                    </div>
                                    <div t-if="record.teacher_class_ids.raw_value" class="mt-1">
                                        <field name="teacher_class_ids" widget="many2many_tags"/>
                                    </div>
                                    <div class="mt-1 text-muted small">
                                        <span t-if="!record.active.raw_value" class="badge text-bg-danger">
                                            Left / Archived
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left text-muted small">
                                        <div t-if="record.email.raw_value"><i class="fa fa-envelope me-1"/><field name="email"/></div>
                                        <div t-if="record.phone.raw_value"><i class="fa fa-phone me-1"/><field name="phone"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Teacher Action -->
    <record id="action_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_teacher', '=', True)]</field>
        <field name="context">{'default_is_teacher': True, 'default_company_type': 'person'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first teacher
            </p>
            <p>
                Teachers are Contacts. Create one here, or open any Contact
                and tick "Is a Teacher" on the Teacher Info tab.
            </p>
        </field>
    </record>

    <record id="action_teacher_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_partner_teacher_kanban"/>
        <field name="act_window_id" ref="action_teacher"/>
    </record>

    <record id="action_teacher_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_partner_teacher_tree"/>
        <field name="act_window_id" ref="action_teacher"/>
    </record>

    <!-- Menu Item for Teachers -->
    <menuitem id="menu_school_teachers"
              name="Teachers"
              parent="menu_school_root"
              action="action_teacher"
              sequence="30"/>
</odoo>