<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add student fields to standard Contact form -->
    <record id="view_partner_form_student" model="ir.ui.view">
        <field name="name">res.partner.form.student</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Student Info" name="student_info">
                    <group>
                        <group string="Basic Details">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="is_student"/>
                            <field name="student_code" invisible="not is_student"/>
                            <field name="student_dob" invisible="not is_student"/>
                            <field name="student_age" invisible="not is_student"/>
                            <field name="student_gender" invisible="not is_student"/>
                        </group>
                        <group string="Academic Enrolment" invisible="not is_student">
                            <field name="student_class_ids" widget="many2many_tags"/>
                            <field name="student_course_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Student Search Filter -->
    <record id="view_partner_search_student" model="ir.ui.view">
        <field name="name">res.partner.search.student</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="student_code"/>
                <field name="student_class_ids"/>
                <field name="student_course_ids"/>
                <filter string="Students" name="students" domain="[('is_student', '=', True)]"/>
                <separator/>
                <filter string="Archived / Left Students" name="inactive" domain="[('active', '=', False), ('is_student', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Student Tree (List) View -->
    <record id="view_partner_student_tree" model="ir.ui.view">
        <field name="name">res.partner.student.tree</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <tree string="Students">
                <field name="student_code"/>
                <field name="name"/>
                <field name="student_class_ids" widget="many2many_tags"/>
                <field name="student_course_ids" widget="many2many_tags"/>
                <field name="student_age"/>
                <field name="student_gender"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Student Kanban View -->
    <record id="view_partner_student_kanban" model="ir.ui.view">
        <field name="name">res.partner.student.kanban</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="student_code"/>
                <field name="student_gender"/>
                <field name="student_age"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="student_class_ids"/>
                <field name="avatar_128"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image: url('#{kanban_image('res.partner', 'avatar_128', record.id.raw_value)}')"/>
                            <div class="oe_kanban_details d-flex flex-column justify-content-between ms-2">
                                <div>
                                    <strong class="o_kanban_record_title oe_partner_heading">
                                        <field name="name"/>
                                    </strong>
                                    <div t-if="record.student_code.raw_value" class="text-muted small">
                                        <i class="fa fa-id-card me-1"/> <field name="student_code"/>
                                    </div>
                                    <div t-if="record.student_class_ids.raw_value" class="mt-1">
                                        <field name="student_class_ids" widget="many2many_tags"/>
                                    </div>
                                    <div class="mt-1 text-muted small">
                                        <span t-if="record.student_gender.raw_value" class="badge text-bg-info me-1">
                                            <field name="student_gender"/>
                                        </span>
                                        <span t-if="record.student_age.raw_value" class="me-1">
                                            <i class="fa fa-birthday-cake me-1"/> <field name="student_age"/> yrs
                                        </span>
                                        <span t-if="!record.active.raw_value" class="badge text-bg-danger">
                                            Left / Archived
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left text-muted small">
                                        <div t-if="record.email.raw_value"><i class="fa fa-envelope me-1"/><field name="email"/></div>
                                        <div t-if="record.phone.raw_value"><i class="fa fa-phone me-1"/><field name="phone"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Student Action (Enables Kanban, Tree, Form, Graph, Pivot) -->
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,graph,pivot</field>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context">{'default_is_student': True, 'default_company_type': 'person'}</field>
    </record>

    <record id="action_student_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_partner_student_kanban"/>
        <field name="act_window_id" ref="action_student"/>
    </record>

    <record id="action_student_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_partner_student_tree"/>
        <field name="act_window_id" ref="action_student"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_school_students"
              name="Students"
              parent="menu_school_root"
              action="action_student"
              sequence="20"/>
</odoo>